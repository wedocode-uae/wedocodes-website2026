<script>
  (function () {
    var supportsTouchEffect = false;

    try {
      supportsTouchEffect =
        window.matchMedia &&
        window.matchMedia("(hover: none), (pointer: coarse)").matches;
    } catch (e) {
      supportsTouchEffect = "ontouchstart" in window || navigator.maxTouchPoints > 0;
    }

    if (!supportsTouchEffect) return;

    function makeRipple(x, y) {
      var ripple = document.createElement("span");
      ripple.className = "wdc-touch-ripple";
      ripple.style.left = x + "px";
      ripple.style.top = y + "px";
      document.body.appendChild(ripple);

      window.setTimeout(function () {
        if (ripple && ripple.parentNode) {
          ripple.parentNode.removeChild(ripple);
        }
      }, 760);
    }

    document.addEventListener("pointerdown", function (event) {
      if (event.pointerType && event.pointerType === "mouse") return;
      makeRipple(event.clientX, event.clientY);
    }, { passive: true });

    document.addEventListener("touchstart", function (event) {
      if (!event.touches || !event.touches.length) return;
      var t = event.touches[0];
      makeRipple(t.clientX, t.clientY);
    }, { passive: true });
  })();
</script>
