<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Industries | WeDoCodes</title>
<meta content="WeDoCodes designs industry-focused software systems, portals, dashboards, automation workflows and cybersecurity controls for retail, restaurants, construction, healthcare, real estate, education, logistics and professional services." name="description"/>
  <!-- FAVICON CODE START -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <!-- FAVICON CODE END -->

<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<style>
    :root{
      --text:#1f1f1f;
      --muted:#5f5f5f;
      --soft:#f5f5f5;
      --line:#e6e6e6;
      --white:#ffffff;

      --brand-orange:#FF9500;
      --brand-orange-2:#FF6A00;
      --brand-pink:#FF3D5E;
      --brand-magenta:#E91E73;

      --blue:#0067b8;
      --blue-dark:#004b8d;
      --green:#107c41;
      --orange:#d83b01;
      --purple:#5c2d91;
      --red:#c4314b;
      --ink:#111827;

      --shadow:0 8px 28px rgba(0,0,0,.10);
      --shadow-soft:0 3px 12px rgba(0,0,0,.08);
      --max:1240px;
      --radius:2px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}

    body{
      margin:0;
      font-family:Inter,"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
      color:var(--text);
      background:#fff;
      overflow-x:hidden;
    }

    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}

    .wrap{
      width:min(var(--max),calc(100% - 48px));
      margin:0 auto;
    }

    .site-header{
      position:sticky;
      top:0;
      z-index:100;
      background:#fff;
      border-bottom:1px solid var(--line);
    }

    .nav{
      height:64px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
    }

    .brand-logo{
      display:inline-flex;
      align-items:center;
      gap:4px;
      height:54px;
      min-width:245px;
      text-decoration:none;
      background:transparent;
      flex:0 0 auto;
    }

    .brand-mark{
      width:50px;
      height:50px;
      display:block;
      flex:0 0 auto;
    }

    .brand-text{
      display:flex;
      flex-direction:column;
      justify-content:center;
      line-height:1;
      min-width:0;
    }

    .brand-name{
      display:block;
      font-size:25px;
      line-height:.94;
      font-weight:760;
      letter-spacing:-1.15px;
      color:#050505;
      white-space:nowrap;
    }

    .brand-name .codes{
      background:linear-gradient(90deg,var(--brand-orange-2),var(--brand-pink),var(--brand-magenta));
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
    }

    .brand-subtitle{
      display:block;
      margin-top:5px;
      font-size:12.5px;
      line-height:1;
      font-weight:500;
      color:#555;
      white-space:nowrap;
      letter-spacing:-.1px;
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:24px;
      font-size:13px;
      color:#262626;
      font-weight:500;
    }

    .nav-links a{
      display:inline-flex;
      align-items:center;
      gap:7px;
      min-height:64px;
      border-bottom:2px solid transparent;
    }

    .nav-links a:hover,
    .nav-links a.active{border-bottom-color:#111}

    .home-icon{
      width:16px;
      height:16px;
      display:inline-block;
    }

    .nav-actions{
      display:flex;
      align-items:center;
      gap:10px;
      font-size:13px;
      font-weight:600;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:40px;
      padding:0 16px;
      border-radius:var(--radius);
      border:1px solid transparent;
      font-weight:600;
      font-size:13px;
      cursor:pointer;
      white-space:nowrap;
      transition:.2s;
    }

    .btn-blue{background:var(--blue);color:#fff}
    .btn-blue:hover{background:var(--blue-dark)}
    .btn-light{background:#fff;color:#1f1f1f;border-color:#8a8a8a}
    .btn-light:hover{background:#f2f2f2}
    .menu-btn{display:none}

    section{padding:56px 0}

    .section-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:34px;
      margin-bottom:30px;
    }

    .section-head.center{
      display:block;
      text-align:center;
      max-width:920px;
      margin:0 auto 34px;
    }

    .kicker{
      font-size:12px;
      font-weight:750;
      color:var(--blue);
      letter-spacing:.12em;
      text-transform:uppercase;
      margin-bottom:9px;
    }

    .section-head h2,
    .section-title{
      font-size:clamp(30px,4vw,52px);
      line-height:1.08;
      letter-spacing:-1.6px;
      margin:0;
      color:#111;
      font-weight:720;
    }

    .section-head p{
      max-width:650px;
      color:#5f5f5f;
      line-height:1.65;
      margin:0;
      font-size:15px;
    }

    /* PAGE COMMAND AREA - NOT A HERO */
    .command{
      background:
        radial-gradient(circle at 88% -18%,rgba(0,103,184,.12),transparent 32%),
        radial-gradient(circle at 14% 0%,rgba(255,149,0,.08),transparent 31%),
        linear-gradient(180deg,#f8fbff 0%,#fff 100%);
      padding:38px 0 26px;
      border-bottom:1px solid var(--line);
    }

    .command-grid{
      display:grid;
      grid-template-columns:1fr auto;
      gap:26px;
      align-items:end;
    }

    .command h1{
      font-size:clamp(34px,4vw,54px);
      line-height:1.06;
      letter-spacing:-1.8px;
      margin:0 0 12px;
      color:#111;
      font-weight:720;
      max-width:840px;
    }

    .command p{
      margin:0;
      color:var(--muted);
      font-size:16px;
      line-height:1.65;
      max-width:820px;
    }

    .command-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .industry-switcher{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-top:26px;
      border-top:1px solid var(--line);
      padding-top:18px;
    }

    .industry-switcher a{
      display:inline-flex;
      align-items:center;
      min-height:34px;
      padding:0 12px;
      border:1px solid var(--line);
      background:#fff;
      color:#333;
      font-size:12px;
      font-weight:700;
      box-shadow:0 1px 4px rgba(0,0,0,.04);
    }

    .industry-switcher a:first-child{
      color:#fff;
      background:var(--blue);
      border-color:var(--blue);
    }

    .metric-row{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:10px;
      margin-top:20px;
      max-width:740px;
    }

    .metric{
      border:1px solid var(--line);
      background:#fff;
      padding:12px;
      box-shadow:var(--shadow-soft);
    }

    .metric b{
      display:block;
      font-size:14px;
      color:#111;
      margin-bottom:5px;
    }

    .metric span{
      display:block;
      color:var(--muted);
      font-size:11px;
      line-height:1.45;
    }

    /* COCKPIT */
    .cockpit{background:#fff}

    .cockpit-board{
      display:grid;
      grid-template-columns:290px 1fr;
      gap:22px;
      align-items:stretch;
    }

    .industry-rail{
      border:1px solid var(--line);
      background:#f8fbff;
      box-shadow:var(--shadow-soft);
      padding:14px;
      display:grid;
      gap:8px;
      align-content:start;
    }

    .rail-title{
      font-size:12px;
      font-weight:800;
      color:#111;
      text-transform:uppercase;
      letter-spacing:.08em;
      padding:4px 2px 7px;
    }

    .rail-item{
      background:#fff;
      border:1px solid var(--line);
      padding:13px;
      display:grid;
      grid-template-columns:26px 1fr;
      gap:10px;
      align-items:center;
      font-size:13px;
      color:#333;
      font-weight:700;
      position:relative;
      overflow:hidden;
    }

    .rail-item.active{
      background:#111827;
      color:#fff;
      border-color:#111827;
    }

    .rail-item::before{
      content:"";
      width:22px;
      height:22px;
      border:1px solid currentColor;
      opacity:.55;
      background:linear-gradient(135deg,rgba(255,149,0,.12),rgba(255,61,94,.08));
    }

    .cockpit-main{
      display:grid;
      grid-template-columns:1fr 360px;
      gap:18px;
    }

    .cockpit-detail{
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      background:#fff;
      padding:28px;
      min-height:510px;
      display:flex;
      flex-direction:column;
    }

    .cockpit-detail small{
      color:var(--blue);
      font-size:12px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.1em;
      margin-bottom:10px;
    }

    .cockpit-detail h2{
      margin:0 0 14px;
      font-size:clamp(30px,3vw,44px);
      line-height:1.08;
      letter-spacing:-1.4px;
    }

    .cockpit-detail p{
      margin:0 0 20px;
      color:var(--muted);
      line-height:1.7;
      font-size:15px;
    }

    .gap-map{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
      margin-bottom:18px;
    }

    .gap-item{
      background:#f8fbff;
      border:1px solid var(--line);
      padding:12px;
      color:#333;
      font-size:12px;
      line-height:1.45;
      font-weight:650;
    }

    .workflow-strip{
      background:#111827;
      color:#fff;
      padding:18px;
      margin-top:auto;
    }

    .workflow-strip b{
      display:block;
      font-size:14px;
      margin-bottom:10px;
    }

    .workflow-flow{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .workflow-flow span{
      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.16);
      color:#e5e7eb;
      font-size:11px;
      font-weight:800;
      padding:7px 8px;
    }

    .cockpit-side{
      display:grid;
      gap:18px;
    }

    .side-image{
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      background:#f8fbff;
      min-height:245px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:14px;
      position:relative;
      overflow:hidden;
    }

    .side-image img{
      width:100%;
      height:100%;
      object-fit:contain;
      object-position:center;
      max-height:225px;
    }

    .side-box{
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      padding:20px;
      position:relative;
      overflow:hidden;
    }

    .side-box::after{
      content:"";
      position:absolute;
      left:20px;
      right:20px;
      bottom:-1px;
      height:3px;
      background:linear-gradient(90deg,var(--brand-orange),var(--brand-pink),var(--brand-magenta));
    }

    .side-box h3{
      margin:0 0 10px;
      font-size:22px;
      letter-spacing:-.7px;
    }

    .side-box p{
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
      margin:0;
    }

    /* OPERATING CARDS */
    .operating{background:#f5f5f5}

    .operating-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:16px;
    }

    .op-card{
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      min-height:328px;
      padding:20px;
      display:flex;
      flex-direction:column;
      position:relative;
      overflow:hidden;
      transition:.2s;
    }

    .op-card:hover{
      transform:translateY(-2px);
      box-shadow:var(--shadow);
    }

    .op-card::before{
      content:"";
      position:absolute;
      top:-52px;
      right:-52px;
      width:132px;
      height:132px;
      border-radius:36px;
      background:linear-gradient(135deg,rgba(0,103,184,.14),rgba(255,149,0,.10),rgba(233,30,115,.08));
      transform:rotate(18deg);
    }

    .op-card:nth-child(2)::before{background:linear-gradient(135deg,rgba(216,59,1,.16),rgba(255,149,0,.12),rgba(255,195,113,.08))}
    .op-card:nth-child(3)::before{background:linear-gradient(135deg,rgba(17,24,39,.13),rgba(75,85,99,.10),rgba(156,163,175,.08))}
    .op-card:nth-child(4)::before{background:linear-gradient(135deg,rgba(16,124,65,.15),rgba(52,211,153,.10),rgba(187,247,208,.08))}
    .op-card:nth-child(5)::before{background:linear-gradient(135deg,rgba(92,45,145,.15),rgba(139,92,246,.10),rgba(196,181,253,.08))}
    .op-card:nth-child(6)::before{background:linear-gradient(135deg,rgba(0,103,184,.12),rgba(16,124,65,.10),rgba(255,149,0,.08))}
    .op-card:nth-child(7)::before{background:linear-gradient(135deg,rgba(196,49,75,.14),rgba(255,61,94,.10),rgba(233,30,115,.08))}
    .op-card:nth-child(8)::before{background:linear-gradient(135deg,rgba(17,24,39,.12),rgba(0,103,184,.10),rgba(255,149,0,.08))}

    .op-card small{
      color:var(--blue);
      font-size:11px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.08em;
      margin-bottom:12px;
      position:relative;
      z-index:2;
    }

    .op-card h3{
      margin:0 0 11px;
      font-size:23px;
      line-height:1.13;
      letter-spacing:-.75px;
      position:relative;
      z-index:2;
    }

    .op-card p{
      margin:0 0 15px;
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
      position:relative;
      z-index:2;
    }

    .op-meta{
      display:grid;
      gap:8px;
      margin-top:auto;
      position:relative;
      z-index:2;
    }

    .op-meta div{
      border:1px solid var(--line);
      background:#f8fbff;
      padding:9px;
      font-size:11px;
      line-height:1.45;
      color:#4b5563;
    }

    .op-meta b{
      color:#111;
    }

    /* WORKFLOW MAPS */
    .workflow-maps{background:#fff}

    .map-stack{
      display:grid;
      gap:12px;
    }

    .map-row{
      display:grid;
      grid-template-columns:210px 1fr 230px;
      gap:12px;
      align-items:stretch;
      border:1px solid var(--line);
      background:#fff;
      box-shadow:var(--shadow-soft);
      padding:12px;
    }

    .map-industry{
      background:#111827;
      color:#fff;
      padding:16px;
      display:flex;
      align-items:center;
      font-size:14px;
      font-weight:800;
    }

    .map-flow{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      align-items:center;
    }

    .map-flow span{
      border:1px solid var(--line);
      background:#f8fbff;
      padding:9px 10px;
      font-size:12px;
      font-weight:750;
      color:#333;
    }

    .map-start{
      border:1px solid var(--line);
      background:#fff;
      padding:12px;
      font-size:12px;
      line-height:1.5;
      color:#333;
      display:flex;
      align-items:center;
    }

    .map-start b{
      color:#111;
    }

    /* MATRIX */
    .matrix{background:#f5f5f5}

    .matrix-wrap{
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      overflow:auto;
      background:#fff;
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:980px;
      font-size:13px;
    }

    th{
      text-align:left;
      background:#111827;
      color:#fff;
      padding:15px 14px;
      font-size:12px;
      border-right:1px solid rgba(255,255,255,.12);
      white-space:nowrap;
    }

    td{
      padding:13px 14px;
      border-top:1px solid var(--line);
      border-right:1px solid var(--line);
      color:#3f3f46;
    }

    td:first-child{
      font-weight:750;
      color:#111;
      background:#f8fbff;
    }

    .check{
      display:inline-flex;
      width:19px;
      height:19px;
      align-items:center;
      justify-content:center;
      background:#e9f6ee;
      color:var(--green);
      font-weight:900;
      font-size:12px;
      border:1px solid rgba(16,124,65,.18);
    }

    .dash{
      color:#9ca3af;
      font-weight:700;
    }

    /* PROBLEM ROUTER */
    .router{background:#fff}

    .router-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .route-card{
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      padding:24px;
      min-height:250px;
      position:relative;
      overflow:hidden;
      display:flex;
      flex-direction:column;
    }

    .route-card::before{
      content:"";
      position:absolute;
      right:-52px;
      top:-52px;
      width:142px;
      height:142px;
      border-radius:38px;
      background:linear-gradient(135deg,rgba(255,149,0,.16),rgba(255,61,94,.11),rgba(233,30,115,.08));
      transform:rotate(18deg);
    }

    .route-card small{
      color:var(--blue);
      font-size:11px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.08em;
      margin-bottom:13px;
      position:relative;
      z-index:2;
    }

    .route-card h3{
      margin:0 0 12px;
      font-size:24px;
      line-height:1.13;
      letter-spacing:-.8px;
      position:relative;
      z-index:2;
    }

    .route-card p{
      margin:0 0 16px;
      color:var(--muted);
      font-size:14px;
      line-height:1.62;
      position:relative;
      z-index:2;
    }

    .route-solution{
      margin-top:auto;
      background:#f8fbff;
      border:1px solid var(--line);
      padding:12px;
      font-size:12px;
      line-height:1.5;
      color:#333;
      position:relative;
      z-index:2;
    }

    .route-solution b{
      display:block;
      color:#111;
      margin-bottom:4px;
    }

    /* SYSTEM LAYERS */
    .layers{background:#f5f5f5}

    .layer-canvas{
      background:#fff;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      padding:28px;
      display:grid;
      grid-template-columns:280px 1fr;
      gap:26px;
      align-items:center;
    }

    .layer-copy h2{
      font-size:clamp(30px,4vw,50px);
      line-height:1.08;
      letter-spacing:-1.6px;
      margin:0 0 16px;
    }

    .layer-copy p{
      color:var(--muted);
      line-height:1.7;
      margin:0 0 22px;
      font-size:15px;
    }

    .layer-flow{
      display:grid;
      gap:12px;
    }

    .system-layer{
      display:grid;
      grid-template-columns:210px 1fr;
      gap:14px;
      align-items:stretch;
    }

    .layer-label{
      background:#111827;
      color:#fff;
      padding:16px;
      font-size:13px;
      font-weight:750;
      display:flex;
      align-items:center;
    }

    .layer-items{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:12px;
    }

    .layer-item{
      border:1px solid var(--line);
      background:#f8fbff;
      padding:14px;
      min-height:75px;
      position:relative;
    }

    .layer-item::after{
      content:"";
      position:absolute;
      left:12px;
      right:12px;
      bottom:-1px;
      height:2px;
      background:linear-gradient(90deg,var(--brand-orange),var(--brand-pink),var(--brand-magenta));
    }

    .layer-item b{
      display:block;
      color:#111;
      font-size:13px;
      margin-bottom:5px;
    }

    .layer-item span{
      color:var(--muted);
      font-size:11px;
      line-height:1.45;
    }

    /* START POINTS / ASSETS */
    .starts{background:#fff}

    .start-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .start-card{
      border:1px solid var(--line);
      box-shadow:var(--shadow-soft);
      background:#fff;
      padding:24px;
      min-height:245px;
      display:flex;
      flex-direction:column;
    }

    .start-card:nth-child(1){border-top:5px solid var(--blue)}
    .start-card:nth-child(2){border-top:5px solid var(--green)}
    .start-card:nth-child(3){border-top:5px solid var(--orange)}
    .start-card:nth-child(4){border-top:5px solid var(--purple)}
