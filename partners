<script>
  (function () {
    var overlay = document.getElementById("wdcSubmitOverlay");

    function ensureOverlay() {
      if (overlay) return overlay;

      overlay = document.createElement("div");
      overlay.className = "wdc-submit-overlay";
      overlay.id = "wdcSubmitOverlay";
      overlay.setAttribute("role", "status");
      overlay.setAttribute("aria-live", "polite");
      overlay.setAttribute("aria-hidden", "true");
      overlay.innerHTML =
        '<div class="wdc-submit-card">' +
          '<div class="wdc-submit-loader" aria-hidden="true"></div>' +
          '<h2 class="wdc-submit-title">Submitting your request</h2>' +
          '<p class="wdc-submit-text">Please wait while we securely send your details.</p>' +
          '<span class="wdc-submit-small">Do not close or refresh this page.</span>' +
        '</div>';
      document.body.appendChild(overlay);
      return overlay;
    }

    function showOverlay() {
      var box = ensureOverlay();
      box.classList.add("is-active");
      box.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
    }

    function disableSubmitControls(form) {
      form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(function (btn) {
        btn.dataset.wdcOriginalText = btn.tagName.toLowerCase() === "button" ? btn.textContent : btn.value;
        if (btn.tagName.toLowerCase() === "button") {
          btn.textContent = "Submitting...";
        } else {
          btn.value = "Submitting...";
        }
        btn.disabled = true;
      });
    }

    document.addEventListener("submit", function (event) {
      var form = event.target;

      if (!form || form.tagName.toLowerCase() !== "form") return;

      if (typeof form.checkValidity === "function" && !form.checkValidity()) {
        return;
      }

      if (form.dataset.wdcSubmitting === "true") {
        event.preventDefault();
        return false;
      }

      form.dataset.wdcSubmitting = "true";
      disableSubmitControls(form);
      showOverlay();
    }, true);
  })();
</script>
